# docker compose bu dosyayi ".env" olarak kopyalayip degerleri doldurun.
# `docker compose --env-file .env up` veya dosyayi ".env" adiyla ayni dizine koyun.

# JWT imzalama anahtari - EN AZ 32 karakter, uretimde rastgele/gizli olmali.
DQA_JWT_SECRET=degistir-bu-en-az-32-karakterlik-gizli-anahtar

# Ollama'nin cekecegi model (bkz. https://ollama.com/library)

DQA_LLM_MODEL=tinyllama

DQ_OCR_ENGINE=tesseract